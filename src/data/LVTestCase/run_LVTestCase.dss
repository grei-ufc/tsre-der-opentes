Clear

Compile (Master.dss)

Set ControlMode=Time

! Desabilita tap changes se houver reguladores
Batchedit RegControl..* maxtapchange=0

! Monitor no início do alimentador da rede LV (LINE1)
New Monitor.Feeder_output_vi element=Line.LINE1 Terminal=1 mode=0
New Monitor.Feeder_output_pq element=Line.LINE1 Terminal=1 mode=1 ppolar=no

! Configuração da simulação diária (passo de 5 min)
Set mode=Daily
Set stepsize=5m
Set number=288

Set MaxControlIter=30