Clear

Compile (IEEE13Nodeckt.dss)

Batchedit RegControl..* maxtapchange=0

Redirect Loadshape.dss

!Redirect edit_load.dss

New EnergyMeter.Feeder Line.650632 1

New Monitor.Feeder_output_vi element=Line.650632 Terminal=1 mode=0
New Monitor.Feeder_output_pq element=Line.650632 Terminal=1 mode=1 ppolar=no

New Monitor.Line96_vi element=Line.L96 Terminal=1 mode=0



Set mode=Daily
Set stepsize=5m
Set number=288

Set MaxControlIter=30